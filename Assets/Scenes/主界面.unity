  m_text: "\u6B22\u8FCE\u60A8\u4F53\u9A8C\u300A\u9A91\u58EB\u51B2\u950B\u300B\uFF01\u6211\u4EEC\u975E\u5E38\u91CD\u89C6\u4FDD\u62A4\u60A8\u7684\u4E2A\u4EBA\u4FE1\u606F\u4E0E\u9690\u79C1\u5B89\u5168\u3002\r\n\u5728\u60A8\u4F7F\u7528\u300A\u9A91\u58EB\u51B2\u950B\u300B\u524D\uFF0C\u8BF7\u4ED4\u7EC6\u9605\u8BFB\u5E76\u5145\u5206\u7406\u89E3\u76F8\u5173\u5185\u5BB9\uFF1A\r\n\r\n1.\u4E3A\u4FDD\u969C\u6E38\u620F\u753B\u9762\u6B63\u5E38\u6E32\u67D3\u3001\u673A\u578B\u9002\u914D\u4E0E\u5F02\u5E38\u5D29\u6E83\u6392\u67E5\uFF0C\u6E38\u620F\u5E95\u5C42\u8C03\u7528\u7684
    Unity3D \u5F15\u64CE \u5C06\u5728\u672C\u5730\u6536\u96C6\u5FC5\u8981\u7684\u8BBE\u5907\u53C2\u6570\uFF08\u5305\u62EC
    Android ID\u3001\u8BBE\u5907\u578B\u53F7\u3001\u64CD\u4F5C\u7CFB\u7EDF\u7248\u672C\u7B49\uFF09\uFF1B\r\n2.\u6E38\u620F\u8FD0\u884C\u9700\u8C03\u7528\u57FA\u7840\u7684\u7F51\u7EDC\u8BBF\u95EE\u6743\u9650\uFF0C\u7528\u4E8E\u7F51\u7EDC\u72B6\u6001\u68C0\u6D4B\u53CA\u5FC5\u8981\u7EC4\u4EF6\u8FD0\u884C\uFF1B\r\n3.\u672C\u6E38\u620F\u4E3A\u5355\u673A\u4F11\u95F2\u4F53\u9A8C\uFF0C\u5173\u5361\u8FDB\u5EA6\u4E0E\u6E38\u620F\u6570\u636E\u5747\u4FDD\u5B58\u5728\u60A8\u7684\u672C\u5730\u8BBE\u5907\uFF1B\r\n4.\u60A8\u4F9D\u6CD5\u4EAB\u6709\u8BBF\u95EE\u3001\u66F4\u6B63\u3001\u5220\u9664\u672C\u5730\u6570\u636E\u53CA\u64A4\u56DE\u6388\u6743\u540C\u610F\u7684\u6743\u5229\u3002\r\n\u8BF7\u70B9\u51FB\u4E0B\u65B9\u94FE\u63A5\u9605\u8BFB\u5B8C\u6574\u7248\u300A\u9A91\u58EB\u51B2\u950B\u9690\u79C1\u653F\u7B56\u300B\u3002\u5982\u60A8\u540C\u610F\uFF0C\u8BF7\u70B9\u51FB\u201C\u540C\u610F\u5E76\u8FDB\u5165\u6E38\u620F\u201D\u5F00\u59CB\u4F53\u9A8C\uFF1B\u5982\u60A8\u4E0D\u540C\u610F\uFF0C\u8BF7\u70B9\u51FB\u201C\u4E0D\u540C\u610F\u5E76\u9000\u51FA\u201D\u3002"
